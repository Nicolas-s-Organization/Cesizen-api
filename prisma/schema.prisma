// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  password    String
  firstname   String
  lastname    String
  birthdate   DateTime
  description String?
  role        UserRole
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trackerItems TrackerItem[]
  articles     Article[]
  categories   Category[]
  emotions     Emotion[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model TrackerItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  emotionId String   @db.Uuid
  comment   String?
  intensity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotion Emotion @relation(fields: [emotionId], references: [id], onDelete: Restrict)

  @@map("tracker_items")
}

model Emotion {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @db.Uuid
  userId    String   @db.Uuid
  name      String
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Emotion?      @relation("EmotionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Emotion[]     @relation("EmotionHierarchy")
  trackerItems TrackerItem[]

  @@map("emotions")
}

model Article {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  categoryId String        @db.Uuid
  title      String
  content    String
  status     ArticleStatus @default(DRAFT)
  imagePath  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("articles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  articles Article[]

  @@map("categories")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refreshTokens")
}
